@echo off
setlocal EnableExtensions DisableDelayedExpansion

rem Build a self-contained WebEditor distribution from the current workspace.
rem Usage: Distribute.bat 2026.09.23

if "%~1"=="" (
    echo Usage: %~nx0 VERSION
    echo Example: %~nx0 2026.09.23
    exit /b 2
)

set "VERSION=%~1"
set "ROOT=%~dp0"
set "TARGET=%ROOT%distribute\%VERSION%"
set "GUI_RELEASE=%ROOT%build\windows-gui\Release"
set "FULL_RELEASE=%ROOT%build\windows-full\Release"

for /f "delims=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz._-" %%A in ("%VERSION%") do (
    echo ERROR: VERSION contains unsupported characters: "%VERSION%"
    exit /b 2
)

if not exist "%GUI_RELEASE%\sim_editor.exe" (
    echo ERROR: Missing %GUI_RELEASE%\sim_editor.exe
    echo Build with: cmake --build --preset windows-gui-release
    exit /b 1
)
if not exist "%GUI_RELEASE%\sim_platform_c.dll" (
    echo ERROR: Missing %GUI_RELEASE%\sim_platform_c.dll
    exit /b 1
)
if not exist "%FULL_RELEASE%\sim_platform_c.dll" (
    echo ERROR: Missing %FULL_RELEASE%\sim_platform_c.dll
    echo Build with: cmake --build --preset windows-full-release
    exit /b 1
)
if not exist "%ROOT%web\package.json" (
    echo ERROR: Missing web\package.json
    exit /b 1
)
if not exist "%ROOT%web\dist\index.html" (
    echo ERROR: Missing web\dist\index.html
    echo Build the frontend with: cd web ^&^& corepack pnpm build
    exit /b 1
)

if exist "%TARGET%" (
    echo ERROR: Distribution already exists: "%TARGET%"
    echo Delete it manually if you want to rebuild this version.
    exit /b 1
)

echo Creating "%TARGET%" ...
mkdir "%TARGET%" || exit /b 1

call :copy_tree "%ROOT%python" "%TARGET%\python" /XD example examples
if errorlevel 1 exit /b 1
call :copy_tree "%ROOT%agent_service" "%TARGET%\agent_service" /XD example examples tests __pycache__ .pytest_cache
if errorlevel 1 exit /b 1
call :copy_tree "%ROOT%web" "%TARGET%\web" /XD node_modules test-results tests e2e __pycache__ .pytest_cache
if errorlevel 1 exit /b 1

rem Keep the runtime directory names expected by Start-WebEditor.ps1 and web/gateway/server.py.
call :copy_runtime "%GUI_RELEASE%" "%TARGET%\build\windows-gui\Release"
if errorlevel 1 exit /b 1
call :copy_runtime "%FULL_RELEASE%" "%TARGET%\build\windows-full\Release"
if errorlevel 1 exit /b 1

call :copy_tree "%FULL_RELEASE%\plugins" "%TARGET%\build\windows-full\Release\plugins"
if errorlevel 1 exit /b 1

copy /Y "%ROOT%Start-WebEditor.ps1" "%TARGET%\" >nul || exit /b 1
copy /Y "%ROOT%Start-LAN-WebEditor.ps1" "%TARGET%\" >nul || exit /b 1
copy /Y "%ROOT%Start-WebEditor-Production.ps1" "%TARGET%\" >nul || exit /b 1
copy /Y "%ROOT%Stop-WebEditor.ps1" "%TARGET%\" >nul || exit /b 1
copy /Y "%ROOT%Deploy-WebEditor.bat" "%TARGET%\" >nul || exit /b 1
copy /Y "%ROOT%README.md" "%TARGET%\README.md" >nul || exit /b 1
copy /Y "%ROOT%docs\HANDOFF_GUIDE.md" "%TARGET%\docs-HANDOFF_GUIDE.md" >nul || exit /b 1
copy /Y "%ROOT%pyproject.toml" "%TARGET%\pyproject.toml" >nul || exit /b 1
copy /Y "%ROOT%DISTRIBUTION.md" "%TARGET%\DISTRIBUTION.md" >nul || exit /b 1

> "%TARGET%\VERSION.txt" echo %VERSION%
> "%TARGET%\PACKAGE_CONTENTS.txt" echo Generated by %~nx0 from %ROOT%
>> "%TARGET%\PACKAGE_CONTENTS.txt" echo Version: %VERSION%
>> "%TARGET%\PACKAGE_CONTENTS.txt" echo Created: %DATE% %TIME%

echo Distribution created successfully:
echo   "%TARGET%"
echo Start locally: powershell -ExecutionPolicy Bypass -File Start-WebEditor.ps1
exit /b 0

:copy_tree
robocopy "%~1" "%~2" /E /COPY:DAT /DCOPY:DAT /R:2 /W:1 %3 %4 %5 %6 %7 %8 %9 >nul
if %ERRORLEVEL% LEQ 7 exit /b 0
echo ERROR: Failed to copy "%~1" to "%~2" (robocopy %ERRORLEVEL%)
exit /b 1

:copy_runtime
robocopy "%~1" "%~2" *.dll *.exe /COPY:DAT /DCOPY:DAT /R:2 /W:1 >nul
if %ERRORLEVEL% LEQ 7 exit /b 0
echo ERROR: Failed to copy runtime "%~1" to "%~2" (robocopy %ERRORLEVEL%)
exit /b 1
