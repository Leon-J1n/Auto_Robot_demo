  <joint name="robotiq_2f85_right_driver_joint" type="revolute">
    <origin xyz="0 0.0306011 0.054904" rpy="0 0 0" />
    <parent link="robotiq_2f85_base" />
    <child link="robotiq_2f85_right_driver" />
    <axis xyz="1 0 0" />
    <limit lower="0" upper="0.8" effort="20" velocity="2" />
    <dynamics damping="0.05" friction="0.01" />
  </joint>
  <!-- Coupler is fixed on both sides (it rides the driver) so a single commanded joint
       drives the fingers: spring_link mirrors the driver at +1 and the follower at -1,
       the same coefficients the MuJoCo build uses for its equality constraints. A fixed
       joint may not be a <mimic> source, so the left coupler declares no mimic either. -->
  <joint name="robotiq_2f85_right_coupler_joint" type="fixed">
    <origin xyz="0 0.0315 -0.0041" rpy="0 0 0" />
    <parent link="robotiq_2f85_right_driver" />
    <child link="robotiq_2f85_right_coupler" />
  </joint>
  <joint name="robotiq_2f85_right_spring_link_joint" type="revolute">
    <origin xyz="0 0.0132 0.0609" rpy="0 0 0" />
    <parent link="robotiq_2f85_base" />
    <child link="robotiq_2f85_right_spring_link" />
    <axis xyz="1 0 0" />
    <limit lower="-0.296706" upper="0.8" effort="20" velocity="2" />
    <dynamics damping="0.05" friction="0.01" />
    <mimic joint="robotiq_2f85_right_driver_joint" multiplier="1" offset="0" />
  </joint>
  <joint name="robotiq_2f85_right_follower_joint" type="revolute">
    <origin xyz="0 0.055 0.0375" rpy="0 0 0" />
    <parent link="robotiq_2f85_right_spring_link" />
    <child link="robotiq_2f85_right_follower" />
    <axis xyz="1 0 0" />
    <limit lower="-0.872665" upper="0.872665" effort="20" velocity="2" />
    <dynamics damping="0.05" friction="0.01" />
    <mimic joint="robotiq_2f85_right_driver_joint" multiplier="-1" offset="0" />
  </joint>
