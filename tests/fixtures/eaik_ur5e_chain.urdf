<?xml version="1.0"?>
<!-- Kinematic test fixture matching the project's scene UR5e; not a dynamics model. -->
<robot name="eaik_ur5e_chain">
  <link name="world"/>
  <link name="base_link"/>
  <joint name="mount" type="fixed">
    <parent link="world"/><child link="base_link"/>
    <origin xyz="0 0 0.5"/>
  </joint>
  <link name="shoulder_link"/>
  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.163"/><axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" effort="150" velocity="3"/>
  </joint>
  <link name="upper_arm_link"/>
  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0.138 0" rpy="0 1.5707963267948966 0"/><axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="150" velocity="3"/>
  </joint>
  <link name="forearm_link"/>
  <joint name="elbow_joint" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0 -0.131 0.425"/><axis xyz="0 1 0"/>
    <limit lower="-3.1415" upper="3.1415" effort="150" velocity="3"/>
  </joint>
  <link name="wrist_1_link"/>
  <joint name="wrist_1_joint" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin xyz="0 0 0.392" rpy="0 1.5707963267948966 0"/><axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="28" velocity="3"/>
  </joint>
  <link name="wrist_2_link"/>
  <joint name="wrist_2_joint" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin xyz="0 0.127 0"/><axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" effort="28" velocity="3"/>
  </joint>
  <link name="wrist_3_link"/>
  <joint name="wrist_3_joint" type="revolute">
    <parent link="wrist_2_link"/><child link="wrist_3_link"/>
    <origin xyz="0 0 0.1"/><axis xyz="0 1 0"/>
    <limit lower="-6.28319" upper="6.28319" effort="28" velocity="3"/>
  </joint>
  <link name="flange"/>
  <joint name="flange_mount" type="fixed">
    <parent link="wrist_3_link"/><child link="flange"/>
    <origin xyz="0 0.1 0" rpy="-1.5707963267948966 0 0"/>
  </joint>
  <link name="tool0"/>
  <joint name="tool_mount" type="fixed">
    <parent link="flange"/><child link="tool0"/>
    <origin xyz="0 0 0.1558" rpy="0 0 -1.5707963267948966"/>
  </joint>
  <!-- Off-chain prismatic finger must not become an EAIK arm coordinate. -->
  <link name="finger"/>
  <joint name="finger_joint" type="prismatic">
    <parent link="flange"/><child link="finger"/><axis xyz="1 0 0"/>
    <limit lower="0" upper="0.05" effort="10" velocity="0.1"/>
  </joint>
</robot>
