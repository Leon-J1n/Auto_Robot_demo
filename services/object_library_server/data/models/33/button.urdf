<?xml version='1.0' encoding='utf-8'?>
<robot name="button">
  <mujoco>
    <compiler discardvisual="false" strippath="false" fusestatic="false" />
  </mujoco>
  <link name="base_link">
    <visual name="stopbot">
      <geometry>
        <mesh filename="button_meshes/stopbot.obj" />
      </geometry>
      <material name="stopbot_color">
        <color rgba="0.15 0.15 0.15 1" />
      </material>
    </visual>
    <visual name="stopbuttonrim">
      <geometry>
        <mesh filename="button_meshes/stopbuttonrim.obj" />
      </geometry>
    </visual>
    <visual name="stoptop">
      <geometry>
        <mesh filename="button_meshes/stoptop.obj" />
      </geometry>
      <material name="stoptop_color">
        <color rgba="0.7 0.5 0 1" />
      </material>
    </visual>
    <collision name="housing_3">
      <origin xyz="0 0.036 0.05099882776" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.048 0.102" />
      </geometry>
    </collision>
    <collision name="housing_4">
      <origin xyz="0 -0.036 0.05099882776" rpy="0 0 0" />
      <geometry>
        <box size="0.12 0.048 0.102" />
      </geometry>
    </collision>
    <collision name="housing_5">
      <origin xyz="-0.0365 0 0.05099882776" rpy="0 0 0" />
      <geometry>
        <box size="0.047 0.024 0.102" />
      </geometry>
    </collision>
    <collision name="housing_6">
      <origin xyz="0.0365 0 0.05099882776" rpy="0 0 0" />
      <geometry>
        <box size="0.047 0.024 0.102" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05260416311" rpy="0 0 0" />
      <mass value="0.35" />
      <inertia ixx="0.0007428397451404301" iyy="0.0007428397451404301" izz="0.0008399999624490741" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <link name="button_link">
    <visual name="stopbutton">
      <geometry>
        <mesh filename="button_meshes/stopbutton.obj" />
      </geometry>
      <material name="stopbutton_color">
        <color rgba="0.6 0 0 1" />
      </material>
    </visual>
    <visual name="stopbuttonrod">
      <geometry>
        <mesh filename="button_meshes/stopbuttonrod.obj" />
      </geometry>
      <material name="stopbuttonrod_color">
        <color rgba="0.15 0.15 0.15 1" />
      </material>
    </visual>
    <collision name="button_contact_stopbutton">
      <origin xyz="0 1.011052458e-05 0.1451911767" rpy="0 0 0" />
      <geometry>
        <box size="0.0424599573 0.04246674767 0.01762088606" />
      </geometry>
    </collision>
    <collision name="button_contact_stopbuttonrod">
      <origin xyz="0 4.870047767e-07 0.1206098068" rpy="0 0 0" />
      <geometry>
        <box size="0.02034055255 0.02037108509 0.03836483799" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 1.011052458e-05 0.1277145038" rpy="0 0 0" />
      <mass value="0.02" />
      <inertia ixx="7.61245753254626e-06" iyy="7.611496393640632e-06" izz="6.010454385755997e-06" ixy="0" ixz="0" iyz="0" />
    </inertial>
  </link>
  <joint name="button_press_joint" type="prismatic">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="button_link" />
    <axis xyz="0 0 -1" />
    <limit lower="0" upper="0.03" effort="20" velocity="0.1" />
    <dynamics damping="3" friction="0.25" />
  </joint>
  <gazebo reference="button_press_joint">
    <springStiffness>120</springStiffness>
    <springReference>-0.004</springReference>
    <implicitSpringDamper>true</implicitSpringDamper>
  </gazebo>
</robot>